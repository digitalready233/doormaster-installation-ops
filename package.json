{
  "name": "doormaster-installation-ops",
  "version": "1.0.0",
  "private": true,
  "description": "DoorMaster Installation Ops - orchestration scripts for the separated frontend (Angular) and backend (Node.js + Prisma) apps",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev": "npm run dev:backend & npm run dev:frontend & wait",
    "start:frontend": "npm --prefix frontend start",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "build:backend": "npm --prefix backend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend test",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:push": "npm --prefix backend run prisma:push",
    "prisma:status": "npm --prefix backend run prisma:status",
    "prisma:studio": "npm --prefix backend run prisma:studio",
    "scrape:all": "npm --prefix backend run scrape:all",
    "icons:generate": "npm --prefix frontend run icons:generate"
  }
}
