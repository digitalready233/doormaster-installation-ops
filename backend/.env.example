# DoorMaster Operations Backend & MySQL Database Configuration
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=doormaster_ops
DATABASE_URL="mysql://root@127.0.0.1:3306/doormaster_ops"

# Authentication — generate with: openssl rand -hex 48
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ISSUER=doormaster-ops
JWT_AUDIENCE=doormaster-ops-web
# Token lifetime in seconds (default: 7 days)
JWT_TTL_SECONDS=604800

# Public App URL
APP_URL="http://localhost:3000"
